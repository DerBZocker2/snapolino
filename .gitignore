box.ini
.venv/
venv/
__pycache__/
*.pyc
cache/
ausgabe/
dist/
build/
*.spec
*.log
.idea/

# Cloud-Backend: echte Zugangsdaten und hochgeladene Rahmen nicht im Repo.
# Ausnahme: preset_*.png sind mitgelieferte Design-Vorlagen (siehe
# backend/sql seed-Daten), keine Kunden-Uploads - die bleiben ignoriert.
backend/includes/config.php
backend/storage/frames/*
!backend/storage/frames/.gitkeep
!backend/storage/frames/.htaccess
!backend/storage/frames/preset_*.png

# Rechnungs-PDFs enthalten personenbezogene Daten, nicht im Repo.
backend/storage/invoices/*
!backend/storage/invoices/.gitkeep
!backend/storage/invoices/.htaccess

# Hochgeladene Event-Fotos der Online-Galerie enthalten personenbezogene
# Daten (Gaeste-Fotos), nicht im Repo.
backend/storage/gallery/*
!backend/storage/gallery/.gitkeep
!backend/storage/gallery/.htaccess

# Fonts fuer backend/tools/generate_presets.py werden per download_fonts.sh
# geladen, nicht im Repo (siehe fonts/README.md dort).
backend/tools/fonts/*.ttf
